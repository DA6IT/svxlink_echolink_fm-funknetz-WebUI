# Production-safe defaults. Do not place credentials in this file.
SVXLINK_WEBUI_DEMO=false
SVXLINK_CONFIG_PATH=/etc/svxlink/svxlink.conf
SVXLINK_NODE_INFO_PATH=/etc/svxlink/node_info.json
SVXLINK_LOG_PATH=/var/log/svxlink
SVXLINK_PID_PATH=/run/svxlink.pid
SVXLINK_SERVICE_NAME=svxlink
# Comma-separated numeric TG identifiers. Empty means no TG selection is confirmed, even if a log line exists.
SVXLINK_TG_ALLOWLIST=
