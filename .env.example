# Production-safe defaults. Do not place credentials in this file.
SVXLINK_WEBUI_DEMO=false
SVXLINK_CONFIG_PATH=/etc/svxlink/svxlink.conf
SVXLINK_NODE_INFO_PATH=/etc/svxlink/node_info.json
SVXLINK_LOG_PATH=/var/log/svxlink
SVXLINK_PID_PATH=/run/svxlink.pid
SVXLINK_SERVICE_NAME=svxlink
# Comma-separated numeric TG identifiers. Empty means no TG selection is confirmed, even if a log line exists.
SVXLINK_TG_ALLOWLIST=
# Confirmed, read-only FM-Funknetz dashboard feeds. The backend retries each feed
# once after a transient failure; no browser-to-broker connection is created.
FM_FUNKNETZ_LIVE_URL=https://dashboard.fm-funknetz.de/data/live.json
FM_FUNKNETZ_LASTHEARD_URL=https://dashboard.fm-funknetz.de/data/lastheard.json
# Confirmed MQTT-over-WebSocket endpoint/topics, retained as read-only deployment
# configuration. MQTT use stays off unless an operator installs a server adapter.
FM_FUNKNETZ_MQTT_ENABLED=false
FM_FUNKNETZ_MQTT_WS_URL=wss://status.thueringen.link/mqtt
# Optional local RF state source. The backend reads this JSONL file only; it never
# opens COMMAND_PTY, DTMF, or PTT control paths. Set true only after SvxLink has
# been configured separately to emit its documented STATE_PTY events here.
SVXLINK_STATE_PTY_ENABLED=false
SVXLINK_STATE_PTY_PATH=/run/svxlink/state.jsonl
# Reserved for a separately validated, one-way local event emitter. Disabled by default.
SVXLINK_LOCAL_EVENT_INPUT_ENABLED=false
# Control is hard-disabled. Do not set credentials here; see README for the
# root-owned deployment-only control configuration required before enabling it.
SVXLINK_CONTROL_ENABLED=false
