[Unit]
Description=SvxLink WebUI FastAPI backend
After=network.target

[Service]
Type=simple
User=svxlink-webui
Group=svxlink-webui
WorkingDirectory=/opt/svxlink-webui/backend
EnvironmentFile=-/etc/svxlink-webui/environment
ExecStart=/opt/svxlink-webui/.venv-current/bin/uvicorn app.main:app --host 127.0.0.1 --port 12346
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
