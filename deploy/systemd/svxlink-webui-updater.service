[Unit]
Description=SvxLink WebUI rootless updater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=svxlink-webui-updater
Group=svxlink-webui-updater
SupplementaryGroups=svxlink-webui-update

WorkingDirectory=/opt/svxlink-webui/backend

ExecStart=/opt/svxlink-webui/.venv/bin/python -m app.updater_worker

Restart=always
RestartSec=2

UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

ReadWritePaths=/opt/svxlink-webui
ReadWritePaths=/var/www/new.shart
ReadWritePaths=/var/lib/svxlink-webui-updater
ReadWritePaths=/var/lib/svxlink-webui-update

[Install]
WantedBy=multi-user.target
